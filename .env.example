# PostgreSQL (collector and Next.js dashboard)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=runtime_tracker
PGUSER=tracker
# Set PGPASSWORD only if your PostgreSQL host authentication requires it.

# Neo4j (collector and Next.js server)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-existing-neo4j-password

# Only needed if you explicitly enable the optional Compose PostgreSQL service.
COMPOSE_PG_PORT=5433
COMPOSE_PGDATABASE=runtime_tracker
COMPOSE_PGUSER=tracker
COMPOSE_PGPASSWORD=

# Compose file whose declared service dependencies are synchronized to Neo4j.
COMPOSE_FILE=demo/docker-compose.yml
GRAPH_PROJECT_NAME=runtime-tracker
